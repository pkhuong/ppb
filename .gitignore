# Ignore everything by default
*

# Opt specific extension back into version control.
!.clang-format
!.gitignore
!LICENSE
!/Makefile
!/*.md
!/*.mk
!/*.sh
!/*.py

!/include/
!/include/ppb/
!/include/ppb/*.h
!/include/ppb/*.hpp

!/src/
!/src/*.c
!/src/*.h

!/examples/
!/examples/*.c

!/stubs-for-frama-c/
!/stubs-for-frama-c/*.h
!/.docker/
!/.docker/Dockerfile

!/fuzz/
!/fuzz/*.c
!/fuzz/*.cc
!/fuzz/*.py

!/tests/
!/tests/*.c
!/tests/*.cc
!/tests/*.py

!/testdata/
!/testdata/*.hex
!/testdata/*.expected
!/testdata/invalid/
!/testdata/invalid/*.hex
!/testdata/invalid/*.expected-error

!/.github
!/.github/workflows/
!/.github/workflows/ci.yml
!/.codecov.yml

!/generator/
!/generator/Makefile
!/generator/*.py
!/generator/*.toml
!/generator/*.md
!/generator/*.sh
!/generator/uv.lock
!/generator/tests/
!/generator/tests/*.py
!/generator/tests/*.cc
!/generator/testdata/
!/generator/testdata/*.proto
!/generator/testdata/*.cc
!/generator/testdata/golden/
!/generator/testdata/golden/*.hpp
!/generator/testdata/invalid/
!/generator/testdata/invalid/*.proto
!/generator/testdata/invalid/*.opt
!/generator/testdata/invalid/*.expected-error
!/generator/testdata/invalid/*.expected-stderr

!/differential/
!/differential/Makefile
!/differential/.gitignore
!/differential/Dockerfile
!/differential/*.py
!/differential/*.toml
!/differential/*.hpp
!/differential/*.cc
!/differential/*.txt
!/differential/*.md
!/differential/*.sh
!/differential/uv.lock
!/differential/fuzz/
!/differential/fuzz/*.cc
!/differential/fuzz/*.hpp
!/differential/fuzz/*.proto
!/differential/fuzz/*.sh

generator/.pytest_cache/
generator/.ruff_cache/
generator/__pycache__/
generator/build/
